# Reference forks are their own git repos (mianshiya, mianshiya-next); not part of this project's history.
reference/

# Claude Code local (machine-specific) settings; shareable config under .claude/ can still be tracked.
.claude/settings.local.json

# 環境變數檔一律不進版控。`.env.example` 例外——那是給人照著填的範本，
# 不含實際值，要跟著 repo 走。
.env*
!.env.example

# Common build/dependency artifacts (populated once backend/frontend scaffolding is added)
node_modules/
target/
dist/
.next/
frontend/out/
*.log
.DS_Store

# Git worktrees (local isolation)
.worktrees/
